<Page
    x:Class="FluentTaskScheduler.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="MinHeight" Value="64"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Body: NavigationView for Sidebar + Content -->
        <NavigationView x:Name="SettingsNav"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="SettingsNav_SelectionChanged"
                        Padding="0">
            
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavAppearanceItem" Tag="Appearance" Content="Appearance" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavNotificationsItem" Tag="Notifications" Content="Notifications">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSystemItem" Tag="System" Content="System">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE770;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAdvancedItem" Tag="Advanced" Content="Advanced">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavCategoriesItem" Tag="Categories" Content="Categories &amp; Tags">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAboutItem" Tag="About" Content="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <!-- Content area -->
                <ScrollViewer x:Name="PageScrollViewer" Padding="28,24,28,24"
                              IsScrollInertiaEnabled="False" VerticalScrollBarVisibility="Auto">
                    <Grid HorizontalAlignment="Stretch">

                    <!-- Appearance -->
                    <StackPanel x:Name="PanelAppearance" Spacing="4" MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock x:Name="AppearanceHeaderText" Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AppThemeTitleText" Text="App Theme" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="AppThemeDescriptionText" Text="Choose Light, Dark, or follow the system setting." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="ThemeComboBox" Grid.Column="1" VerticalAlignment="Center"
                                          SelectionChanged="ThemeComboBox_SelectionChanged" Width="160">
                                    <ComboBoxItem x:Name="ThemeLightItem" Content="Light"/>
                                    <ComboBoxItem x:Name="ThemeDarkItem" Content="Dark"/>
                                    <ComboBoxItem x:Name="ThemeSystemItem" Content="System Default"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="LanguageTitleText" Text="Language" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="LanguageDescriptionText" Text="Choose the display language for the app." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="LanguageComboBox" Grid.Column="1" VerticalAlignment="Center" Width="160" SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="en-US" Content="English"/>
                                    <ComboBoxItem Tag="de-DE" Content="Deutsch"/>
                                    <ComboBoxItem Tag="zh-CN" Content="简体中文"/>
                                    <ComboBoxItem Tag="ja-JP" Content="日本語"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="MicaTitleText" Text="Mica Effect" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="MicaDescriptionText" Text="Apply the Mica translucent background material." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="MicaModeToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" IsOn="True" Toggled="MicaModeToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="OledTitleText" Text="OLED Mode" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="OledDescriptionText" Text="Pure black background to save power on OLED displays. Requires Dark theme." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="OledModeToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" Toggled="OledModeToggle_Toggled"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Notifications -->
                    <StackPanel x:Name="PanelNotifications" Spacing="4" Visibility="Collapsed" MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock x:Name="NotificationsHeaderText" Text="Notifications" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="NotifTaskTitle" Text="Task Notifications" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="NotifTaskDesc" Text="Show a toast when a task starts or fails." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="NotificationsToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" IsOn="True" Toggled="NotificationsToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="NotifRemindersTitle" Text="Upcoming Task Reminders" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="NotifRemindersDesc" Text="Show a reminder toast before a scheduled task is about to run." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="UpcomingRemindersToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" IsOn="True" Toggled="UpcomingRemindersToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="NotifTimingTitle" Text="Reminder Timing" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="NotifTimingDesc" Text="How far in advance to send the reminder." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="ReminderLeadTimeComboBox" Grid.Column="1" VerticalAlignment="Center"
                                          SelectionChanged="ReminderLeadTimeComboBox_SelectionChanged" Width="160">
                                    <ComboBoxItem x:Name="Lead1mItem" Content="1 minute before"/>
                                    <ComboBoxItem x:Name="Lead5mItem" Content="5 minutes before"/>
                                    <ComboBoxItem x:Name="Lead10mItem" Content="10 minutes before"/>
                                    <ComboBoxItem x:Name="Lead15mItem" Content="15 minutes before"/>
                                    <ComboBoxItem x:Name="Lead30mItem" Content="30 minutes before"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- System -->
                    <StackPanel x:Name="PanelSystem" Spacing="4" Visibility="Collapsed" MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock x:Name="SystemHeaderText" Text="System" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="SysStartupTitle" Text="Run on Startup" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="SysStartupDesc" Text="Automatically launch the app when you sign in to Windows." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="RunOnStartupToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" IsOn="False" Toggled="RunOnStartupToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="SysTrayTitle" Text="Minimize to Tray" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="SysTrayDesc" Text="Hide the window to the system tray instead of closing." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="TrayIconToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" IsOn="True" Toggled="TrayIconToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="MinimizeToTrayTitle" Text="Minimize Button Hides to Tray" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="MinimizeToTrayDesc" Text="Also hide the window to the tray when you press the minimize button, not just when closing." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" IsOn="False" Toggled="MinimizeToTrayToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="SysSmoothTitle" Text="Smooth Scrolling" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="SysSmoothDesc" Text="Enable inertia-based scrolling throughout the app." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="SmoothScrollingToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" IsOn="False" Toggled="SmoothScrollingToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="SysPipelineTitle" Text="Task Pipelines" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="SysPipelineDesc" Text="Watch the Task Scheduler event log and start the downstream tasks configured under a task's Completion Actions." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="TaskPipelinesToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" IsOn="True" Toggled="TaskPipelinesToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="SysHiddenTitle" Text="Show Hidden Tasks" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="SysHiddenDesc" Text="Display tasks that are marked as hidden in the Windows Task Scheduler." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowHiddenTasksToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" IsOn="True" Toggled="ShowHiddenTasksToggle_Toggled"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Advanced -->
                    <StackPanel x:Name="PanelAdvanced" Spacing="4" Visibility="Collapsed" MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock x:Name="AdvancedHeaderText" Text="Advanced" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AdvConfirmTitle" Text="Confirm Before Deleting" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="AdvConfirmDesc" Text="Show a confirmation dialog before removing a task." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ConfirmDeleteToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" Toggled="ConfirmDeleteToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AdvLoggingTitle" Text="Application Logging" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="AdvLoggingDesc" Text="Write internal events and errors to a log file for troubleshooting." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="LoggingToggle" OffContent="" OnContent="" IsOn="True" Toggled="LoggingToggle_Toggled"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AdvSepLogsTitle" Text="Separate Log Files" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="AdvSepLogsDesc" Text="Store error and crash logs in dedicated files instead of the main log." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="SeparateLogsToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" IsOn="True" Toggled="SeparateLogsToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}" x:Name="SpecificLogsCard">
                            <StackPanel Spacing="12">
                                <StackPanel>
                                    <TextBlock x:Name="AdvSpecLogsTitle" Text="Specific Logs" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="AdvSpecLogsDesc" Text="Direct access to error and crash records." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <Button x:Name="OpenLogButton" Content="Open Log" HorizontalAlignment="Stretch" Click="OpenLogButton_Click"/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="OpenErrorLogButton" Content="Error Log" HorizontalAlignment="Stretch" Click="OpenErrorLogButton_Click"/>
                                        <Button x:Name="OpenCrashLogButton" Grid.Column="1" Content="Crash Log" HorizontalAlignment="Stretch" Click="OpenCrashLogButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AdvExecHistoryTitle" Text="Execution History Log" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="AdvExecHistoryDesc" Text="Record every task run to a durable log file on disk, independent of the Windows Task Scheduler event log's limited retention." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ExecHistoryLogToggle" Grid.Column="1" VerticalAlignment="Center"
                                             OffContent="" OnContent="" Toggled="ExecHistoryLogToggle_Toggled"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}" x:Name="ExecHistoryFolderCard" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AdvExecHistoryFolderTitle" Text="Execution History Folder" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="AdvExecHistoryFolderDesc" Text="Open the folder containing the monthly execution-history log files." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="OpenExecHistoryFolderButton" Grid.Column="1" Content="Open Folder" Click="OpenExecHistoryFolderButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- Data (folded into Advanced) -->
                        <TextBlock x:Name="DataHeaderText" Text="Data" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,8"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="DataExportTitle" Text="Export Settings" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="DataExportDesc" Text="Save your current settings to a JSON file." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ExportSettingsButton" Grid.Column="1" Content="Export" VerticalAlignment="Center" Click="ExportSettings_Click"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="DataImportTitle" Text="Import Settings" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="DataImportDesc" Text="Restore settings from a previously exported file." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ImportSettingsButton" Grid.Column="1" Content="Import" VerticalAlignment="Center" Click="ImportSettings_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Categories & Tags -->
                    <StackPanel x:Name="PanelCategories" Spacing="16" Visibility="Collapsed" MaxWidth="1200" HorizontalAlignment="Stretch">
                        <TextBlock x:Name="CategoriesHeaderText" Text="Categories &amp; Tags" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>

                        <!-- Categories Section -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="CatManageTitle" Text="Manage Categories" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="CatManageDesc" Text="Predefined categories for your tasks." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewCategoryBox" PlaceholderText="New category name..." KeyDown="NewCategoryBox_KeyDown"/>
                                    <Button x:Name="AddCategoryBtn" Grid.Column="1" Content="Add" Click="AddCategory_Click"/>
                                </Grid>
                                <!-- One row per entry so long names stay readable -->
                                <ItemsControl x:Name="CategoriesItemsControl" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    CornerRadius="4" Padding="12,8" HorizontalAlignment="Stretch">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6,2"
                                                            Click="RemoveCategory_Click" Tag="{Binding}" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Remove">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Tags Section -->
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="TagManageTitle" Text="Manage Tags" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock x:Name="TagManageDesc" Text="Predefined tags for your tasks." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewTagBox" PlaceholderText="New tag name..." KeyDown="NewTagBox_KeyDown"/>
                                    <Button x:Name="AddTagBtn" Grid.Column="1" Content="Add" Click="AddTag_Click"/>
                                </Grid>
                                <!-- One row per entry so long names stay readable -->
                                <ItemsControl x:Name="TagsItemsControl" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                    CornerRadius="4" Padding="12,8" HorizontalAlignment="Stretch">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6,2"
                                                            Click="RemoveTag_Click" Tag="{Binding}" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Remove">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel x:Name="PanelAbout" Spacing="4" Visibility="Collapsed" MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock x:Name="AboutHeaderText" Text="About" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,12"/>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutAppTitle" Text="Fluent Task Scheduler" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="AboutAppDesc" Text="Built with WinUI 3 · Windows App SDK" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6"/>
                                </StackPanel>
                                <Button x:Name="VersionButton" Grid.Column="1" Click="VersionButton_Click"
                                        Background="Transparent" BorderThickness="0" Padding="8,6"
                                        VerticalAlignment="Center" ToolTipService.ToolTip="See What's New">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <!-- Text is filled from the assembly version at runtime -->
                                        <TextBlock x:Name="AboutVersionText" Text="Version"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <FontIcon Glyph="&#xE946;" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AboutUpdateTitle" Text="Check for Updates" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="AboutUpdateDesc" Text="Check if a newer version is available." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressRing x:Name="UpdateCheckProgressRing" IsActive="False" Width="20" Height="20" Visibility="Collapsed"/>
                                    <Button x:Name="CheckForUpdatesButton" Click="CheckForUpdates_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE895;" FontSize="13"/>
                                            <TextBlock x:Name="AboutCheckBtnText" Text="Check"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AboutOnboardTitle" Text="Onboarding" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock x:Name="AboutOnboardDesc" Text="Replay the welcome walkthrough from first launch." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="ReplayOnboardingButton" Grid.Column="1" VerticalAlignment="Center"
                                        Click="ReplayOnboardingButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="13"/>
                                        <TextBlock x:Name="AboutViewAgainText" Text="View Again"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    </Grid>
                </ScrollViewer>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Page>
