<UserControl
    x:Class="FluentTaskScheduler.Controls.FolderTree"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:FluentTaskScheduler.Localization"
    xmlns:vm="using:FluentTaskScheduler.ViewModels"
    IsTabStop="False">

    <UserControl.Resources>
        <!-- One menu for all folders; it finds out which folder it was opened for when it opens. -->
        <MenuFlyout x:Key="FolderMenu" x:Name="FolderMenu" Opening="FolderMenu_Opening">
            <MenuFlyoutItem x:Name="NewSubfolderItem" Text="{x:Bind l:Loc.Get('FolderMenu.NewSubfolder')}" Icon="NewFolder" Click="NewFolder_Click"/>
            <MenuFlyoutItem x:Name="RenameFolderItem" Text="{x:Bind l:Loc.Get('FolderMenu.Rename')}" Icon="Rename" Click="RenameFolder_Click"/>
            <MenuFlyoutItem x:Name="DeleteFolderItem" Text="{x:Bind l:Loc.Get('FolderMenu.Delete')}" Icon="Delete" Click="DeleteFolder_Click"/>
        </MenuFlyout>
    </UserControl.Resources>

    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="16,0,8,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind l:Loc.Get('Main.FoldersHeader')}" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <Button x:Name="ReloadFoldersButton" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8" Click="Reload_Click"
                    ToolTipService.ToolTip="{x:Bind l:Loc.Get('Folders.Reload')}"
                    AutomationProperties.Name="{x:Bind l:Loc.Get('Folders.Reload')}">
                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
            </Button>
            <Button x:Name="NewFolderButton" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8" Click="NewTopFolder_Click"
                    ToolTipService.ToolTip="{x:Bind l:Loc.Get('Dialog.NewFolder.Title')}"
                    AutomationProperties.Name="{x:Bind l:Loc.Get('Dialog.NewFolder.Title')}">
                <FontIcon Glyph="&#xE710;" FontSize="14"/>
            </Button>
        </Grid>

        <TreeView x:Name="Tree" Grid.Row="1" SelectionMode="Single" CanDragItems="False" CanReorderItems="False" AllowDrop="False"
                  ItemsSource="{x:Bind ViewModel.Roots, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                  ItemInvoked="Tree_ItemInvoked">
            <TreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderNode">
                    <!-- IsExpanded is the one place for {Binding}: since Windows App SDK 1.6 the tree takes an item's
                         expansion from its data only if it finds a binding expression on this property, which
                         x:Bind does not make; otherwise it collapses the item and the folder with it. -->
                    <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" ContextFlyout="{StaticResource FolderMenu}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </TreeViewItem>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
