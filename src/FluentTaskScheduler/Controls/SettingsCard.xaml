<UserControl
    x:Class="FluentTaskScheduler.Controls.SettingsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentTaskScheduler.Controls"
    IsTabStop="False">

    <Grid x:Name="Card"
          MinHeight="68" Padding="16,12" ColumnSpacing="16"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{ThemeResource ControlCornerRadius}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FrameStates">
                <VisualState x:Name="Framed"/>
                <VisualState x:Name="Bare">
                    <VisualState.Setters>
                        <Setter Target="Card.Background" Value="Transparent"/>
                        <Setter Target="Card.BorderThickness" Value="0"/>
                        <Setter Target="Card.Padding" Value="0"/>
                        <Setter Target="Card.MinHeight" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Always takes its place, so that a row without a picture lines up with the rows that have one. -->
        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="20" Width="20" Margin="4,0,4,0" VerticalAlignment="Center"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Header, Mode=OneWay}" TextWrapping="Wrap"/>
            <!-- An explanation that changes says what became of something the card's control started,
                 such as a check for updates. It is read out then, since the focus is on the control. -->
            <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                       local:LiveRegion.IsLive="True"
                       Visibility="{x:Bind local:SettingsCard.VisibilityOf(Description), Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ContentPresenter Grid.Column="2" Content="{x:Bind ActionContent, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
