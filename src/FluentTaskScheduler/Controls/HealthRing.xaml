<UserControl
    x:Class="FluentTaskScheduler.Controls.HealthRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:FluentTaskScheduler.Localization"
    IsTabStop="False">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Levels">
                <VisualState x:Name="None"/>
                <VisualState x:Name="Good">
                    <VisualState.Setters>
                        <Setter Target="Ring.Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Fair">
                    <VisualState.Setters>
                        <Setter Target="Ring.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Poor">
                    <VisualState.Setters>
                        <Setter Target="Ring.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- A determinate ring draws its background as the track. A ring that is active is always
             there for a screen reader: the control puts itself back into the content view whatever
             is set here. So it says what it measures, instead of being a progress bar of nothing. -->
        <ProgressRing x:Name="Ring" Width="48" Height="48" IsIndeterminate="False"
                      Value="{x:Bind Score, Mode=OneWay}"
                      Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}"
                      AutomationProperties.Name="{x:Bind l:Loc.Get('DashboardHealthScore.Text')}"/>
    </Grid>
</UserControl>
