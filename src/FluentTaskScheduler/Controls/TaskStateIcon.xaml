<UserControl
    x:Class="FluentTaskScheduler.Controls.TaskStateIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <Grid Width="24" Height="24">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="States">
                <VisualState x:Name="Unknown"/>
                <VisualState x:Name="Ready">
                    <VisualState.Setters>
                        <Setter Target="Icon.Glyph" Value="&#xE73E;"/>
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Running">
                    <VisualState.Setters>
                        <Setter Target="Icon.Visibility" Value="Collapsed"/>
                        <Setter Target="Ring.Visibility" Value="Visible"/>
                        <Setter Target="Ring.IsActive" Value="True"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Queued">
                    <VisualState.Setters>
                        <Setter Target="Icon.Glyph" Value="&#xE823;"/>
                        <Setter Target="Icon.Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                    <VisualState.Setters>
                        <Setter Target="Icon.Glyph" Value="&#xE711;"/>
                        <Setter Target="Icon.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <FontIcon x:Name="Icon" Glyph="&#xE9CE;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
        <ProgressRing x:Name="Ring" Width="20" Height="20" IsActive="False" Visibility="Collapsed"/>
    </Grid>
</UserControl>
