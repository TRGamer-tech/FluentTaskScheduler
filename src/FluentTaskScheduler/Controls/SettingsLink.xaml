<Button
    x:Class="FluentTaskScheduler.Controls.SettingsLink"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentTaskScheduler.Controls"
    MinHeight="68" Padding="16,12"
    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

    <local:SettingsCard IsFramed="False"
                        Glyph="{x:Bind Glyph, Mode=OneWay}"
                        Header="{x:Bind Header, Mode=OneWay}"
                        Description="{x:Bind Description, Mode=OneWay}">
        <FontIcon Glyph="{x:Bind ActionGlyph, Mode=OneWay}" FontSize="12" Margin="8,0,4,0"/>
    </local:SettingsCard>
</Button>
