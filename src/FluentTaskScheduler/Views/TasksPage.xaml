<Page
    x:Class="FluentTaskScheduler.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentTaskScheduler.Controls"
    xmlns:l="using:FluentTaskScheduler.Localization"
    xmlns:local="using:FluentTaskScheduler.Views"
    xmlns:s="using:FluentTaskScheduler.Scheduling"
    xmlns:sn="using:FluentTaskScheduler.Snoozing"
    xmlns:vm="using:FluentTaskScheduler.ViewModels">

    <Page.Resources>
        <!-- One menu for all rows; it finds out which row it was opened for when it opens. -->
        <MenuFlyout x:Key="RowMenu" x:Name="RowMenu" Opening="RowMenu_Opening">
            <MenuFlyoutItem x:Name="RowRunItem" Text="{x:Bind l:Loc.Get('Main.Task.RunNow')}" Icon="Play" Click="RunRow_Click"/>
            <MenuFlyoutItem x:Name="RowStopItem" Text="{x:Bind l:Loc.Get('Main.Task.Stop')}" Icon="Stop" Click="StopRow_Click"/>
            <MenuFlyoutItem x:Name="RowEditItem" Text="{x:Bind l:Loc.Get('Main.Task.Edit')}" Icon="Edit" Click="EditRow_Click"/>
            <MenuFlyoutItem x:Name="RowExportItem" Text="{x:Bind l:Loc.Get('Main.Task.Export')}" Icon="Save" Click="ExportRow_Click"/>
            <MenuFlyoutSubItem x:Name="RowMoveMenu" Text="{x:Bind l:Loc.Get('Tasks.MoveTo')}" Icon="MoveToFolder"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem x:Name="RowDeleteItem" Text="{x:Bind l:Loc.Get('Main.Task.Delete')}" Icon="Delete" Click="DeleteRow_Click"/>
        </MenuFlyout>
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1,6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="220"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24,0,24,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Windows only lists the tasks this user may read. -->
        <InfoBar x:Name="NotElevatedBar" Severity="Informational" IsClosable="True"
                 IsOpen="{x:Bind local:TasksPage.Not(ViewModel.ShowsEveryTask)}"
                 Title="{x:Bind l:Loc.Get('Tasks.NotElevated.Title')}"
                 Message="{x:Bind l:Loc.Get('Tasks.NotElevated.Message')}">
            <InfoBar.ActionButton>
                <Button x:Name="RestartElevatedButton" Content="{x:Bind l:Loc.Get('Tasks.NotElevated.Restart')}"
                        Command="{x:Bind ViewModel.RestartElevatedCommand}"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Each bar is collapsed as well as closed while it has nothing to say: a closed bar would still take the panel's spacing. -->
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="LoadErrorBar" Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
                     Title="{x:Bind l:Loc.Get('Tasks.LoadError.Title')}"
                     Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"/>
            <InfoBar x:Name="SnoozeBanner" Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind Snooze.IsSnoozed, Mode=OneWay}" Visibility="{x:Bind Snooze.IsSnoozed, Mode=OneWay}"
                     Title="{x:Bind Snooze.StatusText, Mode=OneWay}"
                     Message="{x:Bind Snooze.EffectText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Name="SnoozeBannerResume" Content="{x:Bind l:Loc.Get('Snooze.Menu.Resume')}"
                            Command="{x:Bind Snooze.ResumeCommand}"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="SnoozeRestoreBar" Severity="Warning" IsClosable="True"
                     IsOpen="{x:Bind Snooze.ShowsPendingRestores, Mode=OneWay}" Visibility="{x:Bind Snooze.ShowsPendingRestores, Mode=OneWay}"
                     Title="{x:Bind l:Loc.Get('Snooze.Restore.Title')}"
                     Message="{x:Bind Snooze.PendingRestoresText, Mode=OneWay}"
                     CloseButtonClick="SnoozeRestoreBar_CloseButtonClick">
                <InfoBar.ActionButton>
                    <Button x:Name="SnoozeRetryButton" Content="{x:Bind l:Loc.Get('Snooze.Restore.Retry')}"
                            Command="{x:Bind Snooze.RetryRestoresCommand}"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="SnoozeUnreadableBar" Severity="Warning" IsClosable="True"
                     IsOpen="{x:Bind Snooze.ShowsUnreadableStateFile, Mode=OneWay}" Visibility="{x:Bind Snooze.ShowsUnreadableStateFile, Mode=OneWay}"
                     Title="{x:Bind l:Loc.Get('Snooze.Unreadable.Title')}"
                     Message="{x:Bind Snooze.UnreadableStateText, Mode=OneWay}"
                     CloseButtonClick="SnoozeUnreadableBar_CloseButtonClick"/>
        </StackPanel>

        <!-- Search and filter on the left, commands on the right; the command bar moves what does not fit into its menu. -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="240" MinWidth="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find" VerticalAlignment="Center"
                            PlaceholderText="{x:Bind l:Loc.Get('SearchBox.PlaceholderText')}"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"/>
            <ComboBox x:Name="StatusFilterBox" Grid.Column="1" MinWidth="140" VerticalAlignment="Center"
                      SelectedIndex="{x:Bind ViewModel.StatusFilterIndex, Mode=TwoWay}">
                <ComboBoxItem Content="{x:Bind l:Loc.Get('Main.Status.All')}"/>
                <ComboBoxItem Content="{x:Bind l:Loc.Get('Main.Status.Running')}"/>
                <ComboBoxItem Content="{x:Bind l:Loc.Get('Main.Status.Enabled')}"/>
                <ComboBoxItem Content="{x:Bind l:Loc.Get('Main.Status.Disabled')}"/>
                <ComboBoxItem Content="{x:Bind l:Loc.Get('Main.Status.Snoozed')}"/>
            </ComboBox>
            <CommandBar Grid.Column="2" DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Right">
                <AppBarButton x:Name="NewTaskButton" Icon="Add" Label="{x:Bind l:Loc.Get('Main.Nav.NewTask')}" Click="NewTask_Click">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="RefreshButton" Icon="Refresh" Label="{x:Bind l:Loc.Get('Main.Toolbar.Refresh')}" LabelPosition="Collapsed"
                              Command="{x:Bind ViewModel.ReloadCommand}">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5"/>
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="ImportButton" Icon="Import" Label="{x:Bind l:Loc.Get('Main.Toolbar.ImportTask')}" Click="Import_Click"/>
                <AppBarButton x:Name="SortButton" Icon="Sort" Label="{x:Bind ViewModel.SortText, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind ViewModel.SortDescription, Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind ViewModel.SortDescription, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="SortByNameItem" Text="{x:Bind l:Loc.Get('Main.Sort.Name')}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="{x:Bind vm:TaskSort.Name}"/>
                            <MenuFlyoutItem x:Name="SortByStatusItem" Text="{x:Bind l:Loc.Get('Main.Sort.Status')}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="{x:Bind vm:TaskSort.Status}"/>
                            <MenuFlyoutItem x:Name="SortByNextRunItem" Text="{x:Bind l:Loc.Get('Main.Sort.NextRun')}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="{x:Bind vm:TaskSort.NextRun}"/>
                            <MenuFlyoutItem x:Name="SortByLastRunItem" Text="{x:Bind l:Loc.Get('Main.Sort.LastRun')}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="{x:Bind vm:TaskSort.LastRun}"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem x:Name="SortClearItem" Text="{x:Bind l:Loc.Get('Main.Sort.Clear')}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="{x:Bind vm:TaskSort.None}"/>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <!-- For how long to snooze all tasks; while they are snoozed, until when, and the way out. -->
                <AppBarButton x:Name="SnoozeButton" Icon="Pause" Label="{x:Bind Snooze.Caption, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="SnoozeStatusItem" Text="{x:Bind Snooze.StatusText, Mode=OneWay}" IsEnabled="False"
                                            Visibility="{x:Bind Snooze.IsSnoozed, Mode=OneWay}"/>
                            <MenuFlyoutItem x:Name="SnoozeResumeItem" Icon="Play" Text="{x:Bind l:Loc.Get('Snooze.Menu.Resume')}"
                                            Command="{x:Bind Snooze.ResumeCommand}" Visibility="{x:Bind Snooze.IsSnoozed, Mode=OneWay}"/>
                            <MenuFlyoutItem x:Name="SnoozeHalfAnHourItem" Text="{x:Bind l:Loc.Get('Snooze.Duration.30m')}"
                                            Command="{x:Bind Snooze.SnoozeCommand}" CommandParameter="{x:Bind sn:SnoozeChoice.HalfAnHour}"
                                            Visibility="{x:Bind local:TasksPage.VisibleUnless(Snooze.IsSnoozed), Mode=OneWay}"/>
                            <MenuFlyoutItem x:Name="SnoozeOneHourItem" Text="{x:Bind l:Loc.Get('Snooze.Duration.1h')}"
                                            Command="{x:Bind Snooze.SnoozeCommand}" CommandParameter="{x:Bind sn:SnoozeChoice.OneHour}"
                                            Visibility="{x:Bind local:TasksPage.VisibleUnless(Snooze.IsSnoozed), Mode=OneWay}"/>
                            <MenuFlyoutItem x:Name="SnoozeThreeHoursItem" Text="{x:Bind l:Loc.Get('Snooze.Duration.3h')}"
                                            Command="{x:Bind Snooze.SnoozeCommand}" CommandParameter="{x:Bind sn:SnoozeChoice.ThreeHours}"
                                            Visibility="{x:Bind local:TasksPage.VisibleUnless(Snooze.IsSnoozed), Mode=OneWay}"/>
                            <MenuFlyoutItem x:Name="SnoozeUntilRestartItem" Text="{x:Bind l:Loc.Get('Snooze.Duration.Reboot')}"
                                            Command="{x:Bind Snooze.SnoozeCommand}" CommandParameter="{x:Bind sn:SnoozeChoice.UntilRestart}"
                                            Visibility="{x:Bind local:TasksPage.VisibleUnless(Snooze.IsSnoozed), Mode=OneWay}"/>
                            <MenuFlyoutItem x:Name="SnoozeCustomItem" Text="{x:Bind l:Loc.Get('Snooze.Duration.Custom')}" Click="SnoozeCustom_Click"
                                            Visibility="{x:Bind local:TasksPage.VisibleUnless(Snooze.IsSnoozed), Mode=OneWay}"/>
                            <MenuFlyoutSeparator Visibility="{x:Bind local:TasksPage.VisibleUnless(Snooze.IsSnoozed), Mode=OneWay}"/>
                            <!-- Here as well as in the dialog: the banner of a snooze that does not suspend triggers points to it. -->
                            <ToggleMenuFlyoutItem x:Name="SnoozeSuspendTriggersItem" Text="{x:Bind l:Loc.Get('Snooze.SuspendTriggers')}"
                                                  IsChecked="{x:Bind Snooze.SuspendsTriggers, Mode=TwoWay}"
                                                  Visibility="{x:Bind local:TasksPage.VisibleUnless(Snooze.IsSnoozed), Mode=OneWay}"/>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="ShortcutsButton" Icon="Keyboard" Label="{x:Bind l:Loc.Get('Main.ShortcutsDialog.Title')}" Click="Shortcuts_Click">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F1"/>
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <!-- What can be done to several selected tasks at once. -->
        <Grid Grid.Row="3" ColumnSpacing="8" Padding="12,0,0,0" CornerRadius="4"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              Visibility="{x:Bind ViewModel.HasSeveralSelected, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionCount" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Right">
                <AppBarButton x:Name="BatchRunButton" Icon="Play" Label="{x:Bind l:Loc.Get('Main.Batch.Run')}" Command="{x:Bind ViewModel.RunCommand}"/>
                <AppBarButton x:Name="BatchStopButton" Icon="Stop" Label="{x:Bind l:Loc.Get('Main.Batch.Stop')}" Command="{x:Bind ViewModel.StopCommand}"/>
                <AppBarButton x:Name="BatchEnableButton" Icon="Accept" Label="{x:Bind l:Loc.Get('Main.Batch.Enable')}" Command="{x:Bind ViewModel.EnableSelectedCommand}"/>
                <AppBarButton x:Name="BatchDisableButton" Icon="Cancel" Label="{x:Bind l:Loc.Get('Main.Batch.Disable')}" Command="{x:Bind ViewModel.DisableSelectedCommand}"/>
                <AppBarButton x:Name="BatchMoveButton" Icon="MoveToFolder" Label="{x:Bind l:Loc.Get('Tasks.MoveTo')}">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="BatchMoveMenu" Opening="BatchMoveMenu_Opening"/>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="BatchDeleteButton" Icon="Delete" Label="{x:Bind l:Loc.Get('Main.Batch.Delete')}" Command="{x:Bind ViewModel.DeleteCommand}"/>
                <AppBarButton x:Name="ClearSelectionButton" Icon="ClearSelection" Label="{x:Bind l:Loc.Get('Main.Batch.ClearSelectionTooltip')}" Click="ClearSelection_Click"/>
            </CommandBar>
        </Grid>

        <ProgressBar Grid.Row="4" VerticalAlignment="Top" IsIndeterminate="True"
                     Visibility="{x:Bind local:TasksPage.VisibleIfEither(ViewModel.IsLoading, Snooze.IsBusy), Mode=OneWay}"/>

        <TextBlock x:Name="EmptyText" Grid.Row="4" Margin="0,48,0,0" HorizontalAlignment="Center"
                   Text="{x:Bind l:Loc.Get('Tasks.Empty')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind local:TasksPage.VisibleIfNone(ViewModel.Tasks.Count, ViewModel.IsLoading), Mode=OneWay}"/>

        <!-- Hidden: the keys would otherwise show as a tooltip, "Ctrl+E", wherever the pointer rests on the list. -->
        <ListView x:Name="TaskList" Grid.Row="4" Margin="-12,4,-12,0"
                  SelectionMode="Extended" IsItemClickEnabled="True"
                  ItemsSource="{x:Bind ViewModel.Tasks}"
                  KeyboardAcceleratorPlacementMode="Hidden"
                  ItemClick="TaskList_ItemClick" SelectionChanged="TaskList_SelectionChanged">
            <ListView.KeyboardAccelerators>
                <!-- Scoped to the list: Delete in the search box must not delete tasks. -->
                <KeyboardAccelerator Key="E" Modifiers="Control" ScopeOwner="{x:Bind TaskList}" Invoked="EditAccelerator_Invoked"/>
                <KeyboardAccelerator Key="R" Modifiers="Control" ScopeOwner="{x:Bind TaskList}" Invoked="RunAccelerator_Invoked"/>
                <KeyboardAccelerator Key="Delete" ScopeOwner="{x:Bind TaskList}" Invoked="DeleteAccelerator_Invoked"/>
            </ListView.KeyboardAccelerators>
            <ListView.ItemContainerTransitions>
                <TransitionCollection/>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="12,8,12,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="s:TaskRow">
                    <Grid ColumnSpacing="12" Background="Transparent" ContextFlyout="{StaticResource RowMenu}"
                          Opacity="{x:Bind local:TasksPage.OpacityOf(IsHidden), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Every row has the same check box and switch; a screen reader tells them apart by the task's name. -->
                        <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Click="RowCheckBox_Click"
                                  AutomationProperties.Name="{x:Bind local:TasksPage.Named('Tasks.SelectFormat', Name)}"/>
                        <controls:TaskStateIcon Grid.Column="1" VerticalAlignment="Center"
                                                State="{x:Bind State, Mode=OneWay}" IsRunning="{x:Bind IsRunning, Mode=OneWay}"/>

                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind local:TasksPage.NextRunText(NextRunTime), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Visibility="{x:Bind local:TasksPage.VisibleIfSet(NextRunTime), Mode=OneWay}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource BadgeStyle}" Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind local:TasksPage.VisibleIfText(Category), Mode=OneWay}" Tapped="CategoryBadge_Tapped"
                                        ToolTipService.ToolTip="{x:Bind l:Loc.Get('Main.Badge.FilterByCategory')}">
                                    <TextBlock Text="{x:Bind Category, Mode=OneWay}" Style="{StaticResource BadgeTextStyle}"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind local:TasksPage.VisibleIfText(TagsText), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind TagsText, Mode=OneWay}" Style="{StaticResource BadgeTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind IsHidden, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind l:Loc.Get('Main.Badge.Hidden')}" Style="{StaticResource BadgeTextStyle}"/>
                                </Border>
                                <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind HasCompletionActions, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE71B;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind l:Loc.Get('Main.Badge.Chained')}" Style="{StaticResource BadgeTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource BadgeStyle}" Visibility="{x:Bind IsSnoozed, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE769;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind l:Loc.Get('Main.Status.Snoozed')}" Style="{StaticResource BadgeTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource BadgeStyle}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                        Visibility="{x:Bind HasLoadError, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind LoadError, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind l:Loc.Get('Tasks.Badge.Unreadable')}" Style="{StaticResource BadgeTextStyle}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="3" VerticalAlignment="Center" MinWidth="0"
                                      IsOn="{x:Bind EnabledSwitch, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind local:TasksPage.Named('Tasks.EnableFormat', Name)}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
