<Page
    x:Class="FluentTaskScheduler.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentTaskScheduler.Controls"
    xmlns:l="using:FluentTaskScheduler.Localization"
    xmlns:vm="using:FluentTaskScheduler.ViewModels">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
        </Style>
        <!-- Each tile carries half of the gap to its neighbours; see the grid of tiles. -->
        <Style x:Key="TileStyle" TargetType="Grid" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="6"/>
        </Style>
        <Style x:Key="FigureNameStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="NoteStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
        </Style>
        <Style x:Key="LineStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <DataTemplate x:Key="TaskLineTemplate" x:DataType="vm:TaskLine">
            <StackPanel>
                <TextBlock Text="{x:Bind TaskName}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind Text}" Style="{StaticResource NoteStyle}"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="TileLayouts">
                <VisualState x:Name="OneRow"/>
                <VisualState x:Name="TwoRows">
                    <VisualState.Setters>
                        <Setter Target="ThirdTileColumn.Width" Value="0"/>
                        <Setter Target="FourthTileColumn.Width" Value="0"/>
                        <Setter Target="RunsTile.(Grid.Row)" Value="1"/>
                        <Setter Target="RunsTile.(Grid.Column)" Value="0"/>
                        <Setter Target="DurationTile.(Grid.Row)" Value="1"/>
                        <Setter Target="DurationTile.(Grid.Column)" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- What everything below is narrowed to. -->
        <Grid Padding="24,0,24,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="240"/>
                <ColumnDefinition Width="*" MaxWidth="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- The items are given before the selection: a list drops a selection it gets while it is empty. -->
            <ComboBox x:Name="CategoryChoice" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.Categories}"
                      SelectedIndex="{x:Bind ViewModel.CategoryIndex, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind l:Loc.Get('DashboardFilterCategory.Text')}"
                      AutomationProperties.Name="{x:Bind l:Loc.Get('DashboardFilterCategory.Text')}"/>
            <ComboBox x:Name="TagChoice" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ItemsSource="{x:Bind ViewModel.Tags}"
                      SelectedIndex="{x:Bind ViewModel.TagIndex, Mode=TwoWay}"
                      ToolTipService.ToolTip="{x:Bind l:Loc.Get('DashboardFilterTag.Text')}"
                      AutomationProperties.Name="{x:Bind l:Loc.Get('DashboardFilterTag.Text')}"/>
            <Button x:Name="DashboardRefreshButton" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadCommand}"
                    ToolTipService.ToolTip="{x:Bind l:Loc.Get('Main.Toolbar.Refresh')}"
                    AutomationProperties.Name="{x:Bind l:Loc.Get('Main.Toolbar.Refresh')}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5"/>
                </Button.KeyboardAccelerators>
                <SymbolIcon Symbol="Refresh"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Padding="24,0" Spacing="8">
            <InfoBar x:Name="LogOffBar" Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.IsLogOff, Mode=OneWay}"
                     Title="{x:Bind l:Loc.Get('Details.History.Off.Title')}"
                     Message="{x:Bind l:Loc.Get('Details.History.Off.Message')}">
                <InfoBar.ActionButton>
                    <Button x:Name="SwitchLogOnButton" Content="{x:Bind l:Loc.Get('Details.History.SwitchOn')}"
                            Command="{x:Bind ViewModel.SwitchLogOnCommand}"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="ProblemBar" Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Problem, Mode=OneWay}"/>
        </StackPanel>

        <ScrollViewer x:Name="DashboardScroller" Grid.Row="2" Visibility="{x:Bind ViewModel.HasFigures, Mode=OneWay}">
            <StackPanel Padding="24,4,24,24" Spacing="12">

                <!-- Four tiles in a row where they fit, two by two where they do not. The gaps are
                     the tiles' margins, so that the columns the narrow layout leaves empty take no room. -->
                <Grid x:Name="Tiles" Margin="-6" SizeChanged="Tiles_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="ThirdTileColumn" Width="*"/>
                        <ColumnDefinition x:Name="FourthTileColumn" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Style="{StaticResource TileStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind l:Loc.Get('DashboardTotalTasks.Text')}" Style="{StaticResource FigureNameStyle}"/>
                            <TextBlock x:Name="TotalTasksFigure" Text="{x:Bind ViewModel.Figures.TotalTasks, Mode=OneWay}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.Figures.TasksNote, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1" Style="{StaticResource TileStyle}" ColumnSpacing="12"
                          ToolTipService.ToolTip="{x:Bind l:Loc.Get('Dashboard.HealthCaption')}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind l:Loc.Get('DashboardHealthScore.Text')}" Style="{StaticResource FigureNameStyle}"/>
                            <TextBlock x:Name="HealthFigure" Text="{x:Bind ViewModel.Figures.HealthText, Mode=OneWay}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.Figures.HealthNote, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <controls:HealthRing Grid.Column="1" VerticalAlignment="Center"
                                             Score="{x:Bind ViewModel.Figures.HealthValue, Mode=OneWay}"
                                             Level="{x:Bind ViewModel.Figures.Health, Mode=OneWay}"/>
                    </Grid>

                    <Grid x:Name="RunsTile" Grid.Column="2" Style="{StaticResource TileStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind l:Loc.Get('Dashboard.Runs.Title')}" Style="{StaticResource FigureNameStyle}"/>
                            <TextBlock x:Name="RunsFigure" Text="{x:Bind ViewModel.Figures.RunsInPeriod, Mode=OneWay}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.Figures.RunsNote, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DurationTile" Grid.Column="3" Style="{StaticResource TileStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind l:Loc.Get('Dashboard.AvgDuration')}" Style="{StaticResource FigureNameStyle}"/>
                            <TextBlock x:Name="AverageDurationFigure" Text="{x:Bind ViewModel.Figures.AverageDuration, Mode=OneWay}"
                                       Style="{StaticResource TitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.Figures.LongestRun, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid Style="{StaticResource CardStyle}" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind l:Loc.Get('Dashboard.HeatmapTitle')}" Style="{StaticResource SectionTitleStyle}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind l:Loc.Get('Dashboard.PeakHour')}" Style="{StaticResource NoteStyle}"/>
                            <TextBlock x:Name="BusiestHourFigure" Text="{x:Bind ViewModel.Figures.BusiestHour, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- One cell per hour of the day, in one row however wide the page is. An hour
                         without a run is a faint cell; the more runs, the stronger the accent over it. -->
                    <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.Hours}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MaximumRowsOrColumns="24" MinItemWidth="12" MinItemHeight="32"
                                               MinColumnSpacing="2" ItemsStretch="Fill"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HourCell">
                                <Grid CornerRadius="2" Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                      ToolTipService.ToolTip="{x:Bind Description}">
                                    <Border CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{x:Bind Shade}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- A quarter of the row is six hours. -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="00:00" Style="{StaticResource NoteStyle}"/>
                        <TextBlock Grid.Column="1" Text="06:00" Style="{StaticResource NoteStyle}"/>
                        <TextBlock Grid.Column="2" Text="12:00" Style="{StaticResource NoteStyle}"/>
                        <TextBlock Grid.Column="3" Text="18:00" Style="{StaticResource NoteStyle}"/>
                    </Grid>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Style="{StaticResource CardStyle}" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind l:Loc.Get('DashboardCurrentlyRunning.Text')}" Style="{StaticResource SectionTitleStyle}"/>
                        <ListView x:Name="RunningList" Grid.Row="1" Margin="-12,0"
                                  ItemsSource="{x:Bind ViewModel.Running}" ItemTemplate="{StaticResource TaskLineTemplate}"
                                  ItemContainerStyle="{StaticResource LineStyle}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="TaskLine_ItemClick"
                                  AutomationProperties.Name="{x:Bind l:Loc.Get('DashboardCurrentlyRunning.Text')}"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind l:Loc.Get('DashboardNoRunningTasks.Text')}" Style="{StaticResource NoteStyle}"
                                   TextWrapping="Wrap" Visibility="{x:Bind ViewModel.Figures.NothingRunning, Mode=OneWay}"/>
                    </Grid>

                    <Grid Grid.Column="1" Style="{StaticResource CardStyle}" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind l:Loc.Get('DashboardUpcomingSchedule.Text')}" Style="{StaticResource SectionTitleStyle}"/>
                        <ListView x:Name="UpcomingList" Grid.Row="1" Margin="-12,0"
                                  ItemsSource="{x:Bind ViewModel.Upcoming}" ItemTemplate="{StaticResource TaskLineTemplate}"
                                  ItemContainerStyle="{StaticResource LineStyle}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="TaskLine_ItemClick"
                                  AutomationProperties.Name="{x:Bind l:Loc.Get('DashboardUpcomingSchedule.Text')}"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind l:Loc.Get('Dashboard.NothingUpcoming')}" Style="{StaticResource NoteStyle}"
                                   TextWrapping="Wrap" Visibility="{x:Bind ViewModel.Figures.NothingUpcoming, Mode=OneWay}"/>
                    </Grid>
                </Grid>

                <Grid Style="{StaticResource CardStyle}" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind l:Loc.Get('Dashboard.ExecutionStream')}" Style="{StaticResource SectionTitleStyle}"/>
                    <SelectorBar x:Name="LogFilterBar" Grid.Row="1" Margin="-12,0,0,0" SelectionChanged="LogFilter_SelectionChanged">
                        <SelectorBarItem x:Name="LogFilterAll" Text="{x:Bind l:Loc.Get('Dashboard.Filter.All')}" IsSelected="True"/>
                        <SelectorBarItem x:Name="LogFilterSucceeded" Text="{x:Bind l:Loc.Get('RunStatus.Succeeded')}"/>
                        <SelectorBarItem x:Name="LogFilterFailed" Text="{x:Bind l:Loc.Get('RunStatus.Failed')}"/>
                        <SelectorBarItem x:Name="LogFilterSnoozed" Text="{x:Bind l:Loc.Get('Dashboard.Status.Snoozed')}"/>
                    </SelectorBar>
                    <ListView x:Name="DashboardLog" Grid.Row="2" Margin="-12,0"
                              ItemsSource="{x:Bind ViewModel.Log}" ItemContainerStyle="{StaticResource LineStyle}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="LogEntry_ItemClick"
                              AutomationProperties.Name="{x:Bind l:Loc.Get('Dashboard.ExecutionStream')}">
                        <!-- New entries come in at the top while the page is in use; they appear without a fly-in. -->
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection/>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogEntry">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:LogOutcomeIcon VerticalAlignment="Center" Outcome="{x:Bind Outcome}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind TaskName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource NoteStyle}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Bind Status}" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{x:Bind Time}" Style="{StaticResource NoteStyle}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2" Text="{x:Bind l:Loc.Get('Dashboard.NoExecutionEntries')}" Style="{StaticResource NoteStyle}"
                               TextWrapping="Wrap" Visibility="{x:Bind ViewModel.Figures.LogIsEmpty, Mode=OneWay}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- After the figures, so that it shows above them while they are read anew. -->
        <ProgressBar Grid.Row="2" VerticalAlignment="Top" IsIndeterminate="True"
                     Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
    </Grid>
</Page>
