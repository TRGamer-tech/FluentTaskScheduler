<Page
    x:Class="FluentTaskScheduler.Views.ScriptEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:FluentTaskScheduler.Localization"
    xmlns:local="using:FluentTaskScheduler.Views"
    xmlns:vm="using:FluentTaskScheduler.ViewModels">

    <Page.Resources>
        <!-- One template per kind of line, so each takes its colour from the theme the window shows. -->
        <DataTemplate x:Key="OutputLineTemplate" x:DataType="vm:OutputLine">
            <TextBlock Text="{x:Bind Text}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        </DataTemplate>
        <DataTemplate x:Key="ErrorLineTemplate" x:DataType="vm:OutputLine">
            <TextBlock Text="{x:Bind Text}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
        </DataTemplate>
        <DataTemplate x:Key="NoteLineTemplate" x:DataType="vm:OutputLine">
            <TextBlock Text="{x:Bind Text}" FontFamily="Consolas" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </DataTemplate>
        <local:OutputLineTemplateSelector x:Key="OutputLineTemplates"
                                          Output="{StaticResource OutputLineTemplate}"
                                          Error="{StaticResource ErrorLineTemplate}"
                                          Note="{StaticResource NoteLineTemplate}"/>
    </Page.Resources>

    <Grid Padding="24,0,24,24" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="96"/>
        </Grid.RowDefinitions>

        <!-- A button shows its keyboard shortcut in its tooltip by itself. -->
        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton Icon="Play"
                          Label="{x:Bind l:Loc.Get('ScriptEditor_RunBtn.Label')}"
                          Command="{x:Bind ViewModel.RunCommand}"
                          AutomationProperties.AutomationId="ScriptEditorRun">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Icon="Stop"
                          Label="{x:Bind l:Loc.Get('ScriptEditor_StopBtn.Label')}"
                          Command="{x:Bind ViewModel.StopCommand}"
                          AutomationProperties.AutomationId="ScriptEditorStop">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" Modifiers="Shift"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton Icon="Save"
                          Label="{x:Bind l:Loc.Get('ScriptEditor_SaveBtn.Label')}"
                          Command="{x:Bind ViewModel.SaveCommand}"
                          AutomationProperties.AutomationId="ScriptEditorSave">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control"/>
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton Icon="Add"
                          Label="{x:Bind l:Loc.Get('ScriptLibraryCreateBtn.Content')}"
                          Command="{x:Bind ViewModel.NewCommand}"
                          AutomationProperties.AutomationId="ScriptEditorNew"/>
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <TextBox Header="{x:Bind l:Loc.Get('ScriptLibraryNameHeader.Header')}"
                     PlaceholderText="{x:Bind l:Loc.Get('ScriptLibraryNamePlaceholder.PlaceholderText')}"
                     Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="ScriptEditorName"/>
            <TextBox Grid.Column="1"
                     Header="{x:Bind l:Loc.Get('ScriptLibraryDescHeader.Header')}"
                     PlaceholderText="{x:Bind l:Loc.Get('ScriptLibraryDescPlaceholder.PlaceholderText')}"
                     Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="ScriptEditorDescription"/>
        </Grid>

        <TextBox x:Name="ScriptText" Grid.Row="2"
                 VerticalAlignment="Stretch"
                 Text="{x:Bind ViewModel.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="{x:Bind l:Loc.Get('ScriptEditor_CodeEditor.PlaceholderText')}"
                 AutomationProperties.Name="{x:Bind l:Loc.Get('ScriptEditor_CodeEditor.Header')}"
                 AutomationProperties.AutomationId="ScriptEditorText"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 IsSpellCheckEnabled="False"
                 IsTextPredictionEnabled="False"
                 FontFamily="Consolas"
                 FontSize="14"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 PreviewKeyDown="ScriptText_PreviewKeyDown"/>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind l:Loc.Get('ScriptEditor_OutputHeader.Text')}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Bottom"/>
            <Button Grid.Column="1"
                    Content="{x:Bind l:Loc.Get('ScriptEditor.CopyOutput')}"
                    Command="{x:Bind ViewModel.CopyOutputCommand}"
                    AutomationProperties.AutomationId="ScriptEditorCopyOutput"/>
            <Button Grid.Column="2"
                    Content="{x:Bind l:Loc.Get('ScriptEditor_ClearBtn.Label')}"
                    Command="{x:Bind ViewModel.ClearOutputCommand}"
                    AutomationProperties.AutomationId="ScriptEditorClearOutput"/>
        </Grid>

        <ListView x:Name="OutputList" Grid.Row="4"
                  ItemsSource="{x:Bind ViewModel.Output}"
                  ItemTemplateSelector="{StaticResource OutputLineTemplates}"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  Padding="0,8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="{ThemeResource ControlCornerRadius}"
                  AutomationProperties.Name="{x:Bind l:Loc.Get('ScriptEditor_OutputHeader.Text')}"
                  AutomationProperties.AutomationId="ScriptEditorOutput">
            <ListView.ItemContainerStyle>
                <!-- Lines of text, not list entries: no row height of a touch target, no padding of its own. -->
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="20"/>
                    <Setter Property="Padding" Value="12,0"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
