<ContentDialog
    x:Class="FluentTaskScheduler.Dialogs.SnoozeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:FluentTaskScheduler.Localization"
    Title="{x:Bind ViewModel.Title}"
    PrimaryButtonText="{x:Bind l:Loc.Get('Snooze.Dialog.Confirm')}"
    CloseButtonText="{x:Bind l:Loc.Get('Dialog.Common.Cancel')}"
    DefaultButton="Primary"
    PrimaryButtonClick="Snooze_Click">

    <StackPanel Spacing="12" Width="440">
        <InfoBar x:Name="SnoozeProblem" Severity="Error" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Problem, Mode=OneWay}"/>

        <TextBlock Text="{x:Bind l:Loc.Get('Snooze.Dialog.Intro')}" TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.IsForAllTasks}"/>

        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.UntilText}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <DatePicker x:Name="SnoozeDate" AutomationProperties.Name="{x:Bind ViewModel.UntilText}"
                            Date="{x:Bind ViewModel.Date, Mode=TwoWay}"/>
                <TimePicker x:Name="SnoozeTime" AutomationProperties.Name="{x:Bind ViewModel.UntilText}"
                            Time="{x:Bind ViewModel.TimeOfDay, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>

        <!-- What a snooze of all tasks reaches. A task snoozed on its own is always disabled. -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsForAllTasks}">
            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <CheckBox x:Name="SnoozeSuspendTriggers" Content="{x:Bind l:Loc.Get('Snooze.SuspendTriggers')}"
                      IsChecked="{x:Bind ViewModel.AllTasks.SuspendsTriggers, Mode=TwoWay}"/>
            <TextBlock Margin="28,-8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind l:Loc.Get('Snooze.SuspendTriggersHint')}"/>
            <CheckBox x:Name="SnoozeIncludeMicrosoftTasks" Margin="28,0,0,0" Content="{x:Bind l:Loc.Get('Snooze.IncludeMicrosoftTasks')}"
                      IsEnabled="{x:Bind ViewModel.AllTasks.SuspendsTriggers, Mode=OneWay}"
                      IsChecked="{x:Bind ViewModel.AllTasks.IncludesMicrosoftTasks, Mode=TwoWay}"/>
            <InfoBar x:Name="SnoozeMicrosoftWarning" Margin="28,0,0,0" Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.AllTasks.ShowsMicrosoftTasksWarning, Mode=OneWay}"
                     Message="{x:Bind l:Loc.Get('Snooze.IncludeMicrosoftTasksWarning')}"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
