<ContentDialog
    x:Class="FluentTaskScheduler.Dialogs.ImportTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:FluentTaskScheduler.Localization"
    Title="{x:Bind l:Loc.Get('Dialog.ImportTask.Title')}"
    PrimaryButtonText="{x:Bind l:Loc.Get('Dialog.Common.Import')}"
    CloseButtonText="{x:Bind l:Loc.Get('Dialog.Common.Cancel')}"
    DefaultButton="Primary"
    PrimaryButtonClick="Import_Click">

    <ScrollViewer x:Name="ImportScroller" VerticalScrollBarVisibility="Auto" IsTabStop="False">
        <StackPanel Spacing="12" Width="440" Margin="0,0,16,0">
            <InfoBar x:Name="ImportProblem" Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Problem, Mode=OneWay}"/>

            <!-- What the file has Windows run, and when: nothing is registered unseen. -->
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind l:Loc.Get('Details.Actions')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ItemsControl x:Name="ImportActions" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Actions}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" FontFamily="Consolas"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="1" Text="{x:Bind l:Loc.Get('Details.Triggers')}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ItemsControl x:Name="ImportTriggers" Grid.Row="1" Grid.Column="1" ItemsSource="{x:Bind ViewModel.Triggers}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind l:Loc.Get('Editor.NoTriggers')}" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.HasNoTriggers}"/>
            </Grid>

            <TextBox x:Name="ImportName" Header="{x:Bind l:Loc.Get('Dialog.TaskName')}"
                     Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox x:Name="ImportFolder" HorizontalAlignment="Stretch"
                      Header="{x:Bind l:Loc.Get('Dialog.ImportTask.SelectFolder')}"
                      ItemsSource="{x:Bind ViewModel.Folders}"
                      SelectedIndex="{x:Bind ViewModel.FolderIndex, Mode=TwoWay}"/>

            <!-- A task exported on another machine or by another user names an account that means nothing here. -->
            <InfoBar x:Name="ImportAccountMissing" Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.AccountIsMissing}"
                     Message="{x:Bind ViewModel.AccountIsMissingText}"/>
            <RadioButtons x:Name="ImportAccount" Header="{x:Bind l:Loc.Get('Import.Account.Header')}"
                          ItemsSource="{x:Bind ViewModel.AccountOptions}"
                          SelectedIndex="{x:Bind ViewModel.AccountIndex, Mode=TwoWay}"/>
            <PasswordBox x:Name="ImportPassword" Header="{x:Bind l:Loc.Get('Editor.Account.Password')}"
                         Visibility="{x:Bind ViewModel.NeedsPassword, Mode=OneWay}"
                         Password="{x:Bind ViewModel.Password, Mode=TwoWay}"/>
            <CheckBox x:Name="ImportHighestPrivileges" Content="{x:Bind l:Loc.Get('Dialog.HighPriv')}"
                      IsChecked="{x:Bind ViewModel.HighestPrivileges, Mode=TwoWay}"/>
            <InfoBar Severity="Warning" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.NeedsElevation, Mode=OneWay}"
                     Message="{x:Bind l:Loc.Get('Editor.NeedsElevation')}"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
