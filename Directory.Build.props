<Project>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- The library and its tests also build (and the pure tests run) on a non-Windows machine. -->
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <!-- Symbols inside the assemblies, so a crash log from a release build has line numbers: the
             installer leaves separate symbol files out. -->
        <DebugType>embedded</DebugType>
        <!-- Dependencies ship their own translations; the app's languages live in Strings/. -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <!-- NuGet checks every package of a build, also the ones packages bring along, against the list of known
             vulnerabilities. That stays a warning where warnings are errors: an advisory published tomorrow, or
             the list being out of reach, must not stop today's sources, or a tagged release, from building. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    </PropertyGroup>
</Project>
