<ContentDialog
    x:Class="FluentTaskScheduler.Dialogs.TaskPipelineDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentTaskScheduler.Dialogs"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>

        <!-- Card shell shared by the switch row and both branch panels -->
        <Style x:Key="PipelineCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="580" VerticalScrollBarVisibility="Auto" IsScrollInertiaEnabled="False">
        <StackPanel Spacing="12" Width="760" Margin="0,4,12,4">

            <InfoBar x:Name="PipelineInfoBar" IsOpen="True" IsClosable="False" Severity="Informational"/>
            <InfoBar x:Name="PipelineWarningBar" IsOpen="False" IsClosable="True" Severity="Warning"/>

            <!-- Master switch, laid out like a Fluent settings card -->
            <Border Style="{StaticResource PipelineCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D5;" FontSize="18" Opacity="0.8" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="EnableTitle" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="EnableSubtitle" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="PipelineEnabledSwitch" Grid.Column="2" VerticalAlignment="Center"
                                  OnContent="" OffContent="" Toggled="PipelineEnabled_Toggled"/>
                </Grid>
            </Border>

            <Grid x:Name="PipelineBodyPanel" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- On success -->
                <Border Style="{StaticResource PipelineCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OnSuccessHeader" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="OnSuccessHint" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SuccessTaskPicker" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName"/>
                            <Button x:Name="AddSuccessButton" Grid.Column="1" Click="AddSuccess_Click" Style="{StaticResource AccentButtonStyle}">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            </Button>
                        </Grid>

                        <ListView x:Name="SuccessList" Height="150" SelectionMode="Single"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                                  BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                  CornerRadius="6" Padding="2">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PipelineTargetRow">
                                    <Grid ColumnSpacing="10" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8FD;" FontSize="14" Opacity="0.6" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button x:Name="RemoveSuccessButton" Click="RemoveSuccess_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE738;" FontSize="14"/>
                                <TextBlock x:Name="RemoveSuccessText"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- On failure -->
                <Border Grid.Column="1" Style="{StaticResource PipelineCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OnFailureHeader" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="OnFailureHint" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap"/>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="FailureTaskPicker" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName"/>
                            <Button x:Name="AddFailureButton" Grid.Column="1" Click="AddFailure_Click" Style="{StaticResource AccentButtonStyle}">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            </Button>
                        </Grid>

                        <ListView x:Name="FailureList" Height="150" SelectionMode="Single"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                                  BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                  CornerRadius="6" Padding="2">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PipelineTargetRow">
                                    <Grid ColumnSpacing="10" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8FD;" FontSize="14" Opacity="0.6" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Opacity="0.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button x:Name="RemoveFailureButton" Click="RemoveFailure_Click" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE738;" FontSize="14"/>
                                <TextBlock x:Name="RemoveFailureText"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
